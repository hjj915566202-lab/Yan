+    private List<PendingGroup> buildPendingGroups(List<LedgerStore.Tx> source){
+        List<LedgerStore.Tx> pending=new ArrayList<>();
+        for(LedgerStore.Tx t:source)if(t.pending)pending.add(t);
+        Collections.sort(pending,(a,b)->Long.compare(b.notificationTime,a.notificationTime));
+        List<PendingGroup> groups=new ArrayList<>();
+        for(LedgerStore.Tx t:pending){
+            PendingGroup match=null;
+            if(t.notificationTime>0&&!t.mergeExcluded){
+                for(PendingGroup g:groups){
+                    if(g.items.isEmpty()||g.items.get(0).mergeExcluded||g.anchorTime<=0||g.amount!=t.amount)continue;
+                    if(g.anchorTime-t.notificationTime<=PENDING_MERGE_WINDOW_MS){match=g;break;}
+                }
+            }
+            if(match==null){
+                match=new PendingGroup();match.amount=t.amount;match.anchorTime=t.notificationTime;groups.add(match);
+            }
+            match.items.add(t);
+        }
+        return groups;
+    }
+
+    private String notificationTimeText(long time){
+        if(time<=0)return "时间未记录";
+        return new SimpleDateFormat("MM-dd HH:mm:ss",Locale.JAPAN).format(new Date(time));
+    }
