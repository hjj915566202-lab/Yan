+    private String pendingGroupSources(PendingGroup group){
+        Set<String> sources=new LinkedHashSet<>();
+        for(LedgerStore.Tx t:group.items)if(t.source!=null&&!t.source.trim().isEmpty())sources.add(t.source.trim());
+        if(sources.isEmpty())return "自动识别通知";
+        StringBuilder out=new StringBuilder();int i=0;
+        for(String source:sources){if(i++>0)out.append(" · ");out.append(source);if(i>=3&&sources.size()>3){out.append(" 等");break;}}
+        return out.toString();
+    }
