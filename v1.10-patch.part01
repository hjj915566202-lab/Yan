+    private void splitPendingGroup(PendingGroup group){
+        List<LedgerStore.Tx> all=LedgerStore.load(this);Set<String> ids=new LinkedHashSet<>();
+        for(LedgerStore.Tx t:group.items)ids.add(t.id);
+        for(LedgerStore.Tx t:all)if(ids.contains(t.id))t.mergeExcluded=true;
+        LedgerStore.save(this,all);showTransactions(true);
+    }
+
+    private void deletePendingGroup(PendingGroup group){
+        List<LedgerStore.Tx> all=LedgerStore.load(this);Set<String> ids=new LinkedHashSet<>();
+        for(LedgerStore.Tx t:group.items)ids.add(t.id);
+        all.removeIf(t->ids.contains(t.id));LedgerStore.save(this,all);showTransactions(true);
+    }
