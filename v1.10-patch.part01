+            LedgerStore.Tx t=group.items.get(i);
+            if(i>0)detail.append("\n\n────────────\n\n");
+            detail.append("通知 ").append(i+1).append(" / ").append(group.items.size()).append("   ").append(notificationTimeText(t.notificationTime)).append("\n");
+            detail.append(t.source==null?"":t.source).append("\n");
+            detail.append(t.raw==null||t.raw.isEmpty()?"（无原始通知文本）":t.raw);
+        }
+        TextView body=text(detail.toString(),13,false);body.setTextIsSelectable(true);body.setPadding(dp(20),dp(8),dp(20),dp(8));
+        ScrollView scroll=new ScrollView(this);scroll.addView(body);
+        new AlertDialog.Builder(this).setTitle(group.items.size()>1?"已合并 "+group.items.size()+" 条通知":"原始通知").setView(scroll).setPositiveButton("关闭",null).show();
+    }
