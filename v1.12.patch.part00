+    private void applyAnalysisQuickRange(String label){
+        LocalDate today=LocalDate.now();
+        analysisRangeMonth="custom";
+        if("近30天".equals(label)){analysisStart=today.minusDays(29);analysisEnd=today;return;}
+        if("近3个月".equals(label)){analysisStart=today.minusMonths(3).plusDays(1);analysisEnd=today;return;}
+        if("近1年".equals(label)){analysisStart=today.minusYears(1).plusDays(1);analysisEnd=today;return;}
+        LocalDate earliest=null;
+        for(LedgerStore.Tx tx:LedgerStore.load(this)){
+            if(tx.pending||"固定支出".equals(tx.category)||tx.date==null||tx.date.length()<10)continue;
+            try{LocalDate d=LocalDate.parse(tx.date);if(earliest==null||d.isBefore(earliest))earliest=d;}catch(Exception ignored){}
+        }
+        if(earliest==null)earliest=YearMonth.parse(selectedMonth).atDay(1);
+        analysisStart=earliest;analysisEnd=today.isBefore(earliest)?earliest:today;
+    }
+
