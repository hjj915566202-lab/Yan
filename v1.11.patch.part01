+    private String trendBucket(String isoDate,String granularity){
+        LocalDate date=LocalDate.parse(isoDate);
+        if("每年".equals(granularity))return String.valueOf(date.getYear());
+        if("每月".equals(granularity))return YearMonth.from(date).toString();
+        if("每周".equals(granularity))return date.minusDays(date.getDayOfWeek().getValue()-1L).toString();
+        return isoDate;
+    }
+
+    private TrendData aggregateTrend(AnalysisData data,String granularity){
+        TrendData out=new TrendData();
+        if(data.dates.isEmpty())return out;
+        Map<String,Integer> bucketIndex=new LinkedHashMap<>();
+        for(String date:data.dates){
+            String bucket=trendBucket(date,granularity);
+            if(!bucketIndex.containsKey(bucket)){bucketIndex.put(bucket,bucketIndex.size());out.labels.add(bucket);}
+        }
+        for(String key:data.trend.keySet())out.series.put(key,new long[out.labels.size()]);
+        for(int i=0;i<data.dates.size();i++){
+            Integer target=bucketIndex.get(trendBucket(data.dates.get(i),granularity));if(target==null)continue;
+            for(Map.Entry<String,long[]> entry:data.trend.entrySet()){
+                long[] source=entry.getValue();if(i<source.length)out.series.get(entry.getKey())[target]+=source[i];
+            }
+        }
+        return out;
+    }
+
+    private String trendTitle(){
+        if("每周".equals(analysisTrendGranularity))return "每周花费趋势";
+        if("每月".equals(analysisTrendGranularity))return "每月花费趋势";
+        if("每年".equals(analysisTrendGranularity))return "每年花费趋势";
+        return "每日花费趋势";
+    }
+
+    private String focusForWallet(String wallet){
+        if("公用".equals(wallet))return analysisSharedFocus;
+        if("总计".equals(wallet))return analysisTotalFocus;
+        return analysisPersonalFocus;
+    }
+
+    private void setFocusForWallet(String wallet,String value){
+        if("公用".equals(wallet))analysisSharedFocus=value;
+        else if("总计".equals(wallet))analysisTotalFocus=value;
+        else analysisPersonalFocus=value;
+    }
+
