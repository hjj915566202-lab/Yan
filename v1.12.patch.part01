+            if(i<quickLabels.length-1){Space gap=new Space(this);quickRanges.addView(gap,new LinearLayout.LayoutParams(dp(6),1));}
+        }
+        addToCard(controls,quickRanges);
         Button reset=ghostButton("恢复当前所选月份");reset.setOnClickListener(v->{analysisRangeMonth="";ensureAnalysisRange();showAnalytics();});controls.addView(reset);addSurface(controls);
 
         if(analysisEnd.isBefore(analysisStart)){LinearLayout err=surfaceCard();TextView e=text("结束日期不能早于开始日期。",15,true);e.setTextColor(COLOR_DANGER);err.addView(e);addSurface(err);return;}
