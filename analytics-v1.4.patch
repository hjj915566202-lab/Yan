+    private AnalysisData buildAnalysis(LocalDate start,LocalDate end){
+        AnalysisData out=new AnalysisData();
+        int days=(int)ChronoUnit.DAYS.between(start,end)+1;
+        Map<String,Integer> dayIndex=new LinkedHashMap<>();
+        for(int i=0;i<days;i++){
+            String date=start.plusDays(i).toString();
+            out.dates.add(date);dayIndex.put(date,i);
+        }
+        out.trend.put("总支出",new long[days]);
+        for(String cat:cats)out.trend.put(cat,new long[days]);
+        Map<String,Long> pieTotals=new LinkedHashMap<>();
+        for(String cat:cats)pieTotals.put(cat,0L);
+
+        String startText=start.toString(),endText=end.toString();
+        for(LedgerStore.Tx tx:LedgerStore.load(this)){
+            if(tx.pending || "固定支出".equals(tx.category) || tx.date==null)continue;
+            if(tx.date.compareTo(startText)<0 || tx.date.compareTo(endText)>0)continue;
+            Integer index=dayIndex.get(tx.date);if(index==null)continue;
+            String category="其他";
+            for(String cat:cats)if(cat.equals(tx.category)){category=cat;break;}
+            out.trend.get("总支出")[index]+=tx.amount;
+            out.trend.get(category)[index]+=tx.amount;
+            pieTotals.put(category,pieTotals.get(category)+tx.amount);
+            out.dailyTotal+=tx.amount;
+        }
+
+        YearMonth cursor=YearMonth.from(start);
+        YearMonth last=YearMonth.from(end);
+        while(!cursor.isAfter(last)){
+            LocalDate monthStart=start.isAfter(cursor.atDay(1))?start:cursor.atDay(1);
+            LocalDate monthEnd=end.isBefore(cursor.atEndOfMonth())?end:cursor.atEndOfMonth();
+            int covered=(int)ChronoUnit.DAYS.between(monthStart,monthEnd)+1;
+            double ratio=covered/(double)cursor.lengthOfMonth();
+            for(LedgerStore.FixedExpense item:LedgerStore.fixedExpenses(this,cursor.toString())){
+                long amount=Math.round(item.amount*ratio);
+                if(amount<=0)continue;
+                String label="固定·"+item.name+"（"+item.wallet+"）";
+                pieTotals.put(label,pieTotals.getOrDefault(label,0L)+amount);
+                out.fixedTotal+=amount;
+            }
+            cursor=cursor.plusMonths(1);
+        }
+        for(Map.Entry<String,Long> entry:pieTotals.entrySet())if(entry.getValue()>0)out.pie.add(new ExpensePieView.Slice(entry.getKey(),entry.getValue()));
+        return out;
+    }
