+    private void ensureAnalysisRange(){
+        if(analysisStart!=null && analysisEnd!=null && selectedMonth.equals(analysisRangeMonth))return;
+        YearMonth month=YearMonth.parse(selectedMonth);
+        analysisStart=month.atDay(1);
+        LocalDate today=LocalDate.now();
+        analysisEnd=YearMonth.from(today).equals(month)?today:month.atEndOfMonth();
+        analysisRangeMonth=selectedMonth;
+    }
+
+    private void pickAnalysisDate(boolean startDate){
+        LocalDate initial=startDate?analysisStart:analysisEnd;
+        DatePickerDialog dialog=new DatePickerDialog(this,(view,year,month,day)->{
+            LocalDate chosen=LocalDate.of(year,month+1,day);
+            if(startDate){
+                analysisStart=chosen;
+                if(analysisEnd.isBefore(chosen))analysisEnd=chosen;
+            }else{
+                analysisEnd=chosen;
+                if(analysisStart.isAfter(chosen))analysisStart=chosen;
+            }
+            analysisRangeMonth=selectedMonth;
+            showAnalytics();
+        },initial.getYear(),initial.getMonthValue()-1,initial.getDayOfMonth());
+        dialog.show();
+    }
