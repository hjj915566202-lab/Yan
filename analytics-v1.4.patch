+    private static final class AnalysisData {
+        final List<String> dates=new ArrayList<>();
+        final Map<String,long[]> trend=new LinkedHashMap<>();
+        final List<ExpensePieView.Slice> pie=new ArrayList<>();
+        long dailyTotal,fixedTotal;
+    }
